// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int     @id @default(autoincrement()) //also means ID SERIAL PRIMARY KEY (SERIAL - auto increment)
  email       String  @unique
  firstName   String
  lastName    String? //?- optional
  password    String
  phoneNumber String? @unique
}

model Todo {
  id          Int     @id @default(autoincrement())
  title       String
  done        Boolean @default(false)
  description String
  userId      Int
}
